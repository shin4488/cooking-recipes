// このファイルを Config/Local.xcconfig にコピーして値を入れる。Local.xcconfig は git で管理しない
// 手順は docs/release-checklist.md を参照

// Apple Developer の Team ID（Xcode の Signing & Capabilities で選ぶチーム）
DEVELOPMENT_TEAM =

// 設定画面・利用条件・プライバシー説明に表示する運営者名
OPERATOR_NAME =

// 問い合わせ先のメールアドレス
CONTACT_EMAIL =

// AdMob のアプリ ID（ca-app-pub-…~… の形）。Release ビルドで使う。Debug ビルドは常に Google のテスト用の ID を使う
ADMOB_APP_ID =

// 一覧の下に出すバナーの広告ユニット ID（ca-app-pub-…/… の形）。Release ビルドで使う。Debug ビルドは常に Google のテスト用の ID を使う
ADMOB_BANNER_UNIT_ID =

// AdMob のパブリッシャー ID（pub-… の形）。web/build.sh が app-ads.txt に入れる
ADMOB_PUBLISHER_ID =
