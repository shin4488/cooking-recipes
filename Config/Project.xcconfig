// 公開前に入れる値は、git管理外の Config/Local.xcconfig に書く（書き方は Config/Local.example.xcconfig）
DEVELOPMENT_TEAM =
OPERATOR_NAME =
CONTACT_EMAIL =
ADMOB_APP_ID =
ADMOB_BANNER_UNIT_ID =
ADMOB_PUBLISHER_ID =

#include? "Local.xcconfig"

// Info.plist に入れる AdMob の ID。Debug ビルドは、開発中の端末で本番の広告を表示・タップしないよう、常に Google のテスト用の ID を使う
ADMOB_APP_ID_RESOLVED = $(ADMOB_APP_ID)
ADMOB_APP_ID_RESOLVED[config=Debug] = ca-app-pub-3940256099942544~1458002511
ADMOB_BANNER_UNIT_ID_RESOLVED = $(ADMOB_BANNER_UNIT_ID)
ADMOB_BANNER_UNIT_ID_RESOLVED[config=Debug] = ca-app-pub-3940256099942544/2435281174
