// 公開前に入れる値は、git管理外の Config/Local.xcconfig に書く（書き方は Config/Local.example.xcconfig）
DEVELOPMENT_TEAM =
OPERATOR_NAME =
CONTACT_EMAIL =
ADMOB_APP_ID =
ADMOB_BANNER_UNIT_ID =
ADMOB_PUBLISHER_ID =

#include? "Local.xcconfig"

// Info.plist に入れる AdMob の ID。Debug ビルドで値が空なら Google のテスト用の ID を使い、Release ビルドではテスト用の ID を使わない
ADMOB_TEST_APP_ID[config=Debug] = ca-app-pub-3940256099942544~1458002511
ADMOB_TEST_BANNER_UNIT_ID[config=Debug] = ca-app-pub-3940256099942544/2435281174
ADMOB_APP_ID_RESOLVED = $(ADMOB_APP_ID:default=$(ADMOB_TEST_APP_ID))
ADMOB_BANNER_UNIT_ID_RESOLVED = $(ADMOB_BANNER_UNIT_ID:default=$(ADMOB_TEST_BANNER_UNIT_ID))
